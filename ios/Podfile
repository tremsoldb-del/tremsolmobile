platform :ios, '13.0'

# Use STATIC frameworks (more stable with Flutter)
use_frameworks! :linkage => :static

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end
  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  # (do NOT repeat use_frameworks! here)
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  # Apply to the Pods project (all configs)
  installer.pods_project.build_configurations.each do |config|
    config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
    # Keep module caches LOCAL to this project
    config.build_settings['CLANG_MODULE_CACHE_PATH'] = '$(SRCROOT)/ModuleCache.noindex'
    config.build_settings['SWIFT_MODULE_CACHE_PATH'] = '$(SRCROOT)/ModuleCache.noindex'
    # Also pass cache path via flags (clang + Swift importer)
    config.build_settings['OTHER_CFLAGS']      = '$(inherited) -fmodules-cache-path=$(SRCROOT)/ModuleCache.noindex'
    config.build_settings['OTHER_SWIFT_FLAGS'] = '$(inherited) -Xcc -fmodules-cache-path=$(SRCROOT)/ModuleCache.noindex'
    config.build_settings['ONLY_ACTIVE_ARCH'] = 'YES'
  end

  # Some pods read target-level only—set there too
  installer.pods_project.targets.each do |t|
    flutter_additional_ios_build_settings(t)
    t.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      config.build_settings['CLANG_MODULE_CACHE_PATH'] = '$(SRCROOT)/ModuleCache.noindex'
      config.build_settings['SWIFT_MODULE_CACHE_PATH'] = '$(SRCROOT)/ModuleCache.noindex'
      config.build_settings['OTHER_CFLAGS']      = '$(inherited) -fmodules-cache-path=$(SRCROOT)/ModuleCache.noindex'
      config.build_settings['OTHER_SWIFT_FLAGS'] = '$(inherited) -Xcc -fmodules-cache-path=$(SRCROOT)/ModuleCache.noindex'
      config.build_settings['ONLY_ACTIVE_ARCH'] = 'YES'
      # On Intel Macs, if you hit arm64-simulator issues, uncomment:
      # config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
    end
  end
end
